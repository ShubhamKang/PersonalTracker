# Copy this file to .env and fill in real values. .env is gitignored.

# --- Database ---
# Matches docker-compose.yml credentials for local dev
DATABASE_URL="postgresql://tracker:tracker_dev_pw@localhost:5432/personal_tracker?schema=public"

# --- App ---
PORT=3000

# --- Auth ---
# Generate a strong secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-in-real-env"
JWT_EXPIRES_IN="7d"

# --- Google OAuth ---
# Create an OAuth 2.0 Client ID in Google Cloud Console.
# Google sign-in stays disabled (returns 401) until GOOGLE_CLIENT_ID is set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
