# Copy this file to .env and fill in real values. .env is gitignored.

# --- Database ---
# Matches docker-compose.yml credentials for local dev
DATABASE_URL="postgresql://tracker:tracker_dev_pw@localhost:5432/personal_tracker?schema=public"

# --- App ---
PORT=3000

# --- Auth (used in Phase 0 chunk b) ---
JWT_SECRET="change-me-in-real-env"
JWT_EXPIRES_IN="7d"

# --- Google OAuth (used in Phase 0 chunk b) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
