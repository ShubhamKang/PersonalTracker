{
  "expo": {
    "name": "Personal Tracker",
    "slug": "personal-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "personaltracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shubhamkang.personaltracker"
    },
    "android": {
      "package": "com.shubhamkang.personaltracker"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
